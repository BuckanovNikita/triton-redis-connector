name: "{{ config.name }}"
{% if config.backend is not none %}
backend: "{{ config.backend }}"
{% else %}
platform: "{{ config.platform }}"
{% endif %}
max_batch_size: {{ config.max_batch_size }}
{% if config.default_model_filename %}
default_model_filename: "{{ config.default_model_filename }}"
{% endif %}

{% for tensor in config.inputs %}
input [
  {
    name: "{{ tensor.name }}"
    data_type: {{ tensor.data_type.value }}
    dims: [ {{ tensor.dims | join(", ") }} ]
{% if tensor.is_shape_tensor %}
    is_shape_tensor: true
{% endif %}
  }
]

{% endfor %}
{% for tensor in config.outputs %}
output [
  {
    name: "{{ tensor.name }}"
    data_type: {{ tensor.data_type.value }}
    dims: [ {{ tensor.dims | join(", ") }} ]
{% if tensor.is_shape_tensor %}
    is_shape_tensor: true
{% endif %}
  }
]

{% endfor %}
{% if config.ensemble_scheduling is not none %}
ensemble_scheduling {
  step [
{% for step in config.ensemble_scheduling %}
    {
      model_name: "{{ step.model_name }}"
      model_version: {{ step.model_version }}
{% for m in step.input_map %}
      input_map {
        key: "{{ m.key }}"
        value: "{{ m.value }}"
      }
{% endfor %}
{% for m in step.output_map %}
      output_map {
        key: "{{ m.key }}"
        value: "{{ m.value }}"
      }
{% endfor %}
    }{{ "," if not loop.last else "" }}
{% endfor %}
  ]
}
{% else %}
instance_group [
  {
    count: {{ config.instance_count }}
    kind: {{ config.instance_kind.value }}
  }
]
{% endif %}

{% if config.dynamic_batching is not none %}
dynamic_batching {
{% if config.dynamic_batching.max_queue_delay_microseconds > 0 %}
  max_queue_delay_microseconds: {{ config.dynamic_batching.max_queue_delay_microseconds }}
{% endif %}
{% if config.dynamic_batching.preferred_batch_size %}
  preferred_batch_size: [ {{ config.dynamic_batching.preferred_batch_size | join(", ") }} ]
{% endif %}
}
{% endif %}

{% if config.optimization is not none %}
optimization {
{% if config.optimization.graph_level >= 0 %}
  graph_level: {{ config.optimization.graph_level }}
{% endif %}
{% if config.optimization.cuda_graphs %}
  cuda { graphs: true }
{% endif %}
}
{% endif %}

{% for warmup in config.model_warmup or [] %}
model_warmup [
  {
    name: "{{ warmup.name }}"
    batch_size: {{ warmup.batch_size }}
{% for input_name, spec in warmup.inputs.items() %}
    inputs {
      key: "{{ input_name }}"
      value {
        data_type: {{ spec.data_type.value }}
        dims: [ {{ spec.dims | join(", ") }} ]
        {{ "zero_data" if spec.zero_data else "random_data" }} {}
      }
    }
{% endfor %}
  }
]

{% endfor %}
{% for key, value in config.parameters.items() %}
parameters {
  key: "{{ key }}"
  value: { string_value: "{{ value }}" }
}

{% endfor %}
