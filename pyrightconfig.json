{
    "pythonVersion": "3.12",
    "typeCheckingMode": "strict",
    "include": [
        "packages/triton_redis_connector/triton_redis_connector",
        "packages/triton_model_tools/triton_model_tools"
    ],
    "exclude": [
        "**/__pycache__",
        ".venv",
        "build",
        "dist",
        "packages/triton_model_tools/triton_model_tools/export/scripts",
        "packages/triton_model_tools/triton_model_tools/benchmarks/fiftyone_export.py",
        "**/node_modules",
        "**/.*"
    ],
    "reportMissingTypeStubs": "warning",
    "reportPrivateUsage": true,
    "reportUnknownMemberType": "warning",
    "reportUnknownVariableType": "warning",
    "reportUnknownArgumentType": "warning"
}
